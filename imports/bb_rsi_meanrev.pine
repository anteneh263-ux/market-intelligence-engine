//@version=5
strategy("Bollinger + RSI Mean Reversion", overlay=true, initial_capital=10000)

// A common TradingView mean-reversion template: fade band extremes only when
// the RSI oscillator confirms an oversold/overbought condition.
bbLength = input.int(20,  "BB Length")
bbMult   = input.float(2.0, "BB StdDev")
rsiLen   = input.int(14,  "RSI Length")
osLevel  = input.int(30,  "RSI Oversold")
obLevel  = input.int(70,  "RSI Overbought")

basis = ta.sma(close, bbLength)
dev   = bbMult * ta.stdev(close, bbLength)
upper = basis + dev
lower = basis - dev
r     = ta.rsi(close, rsiLen)

longCond  = close < lower and r < osLevel
shortCond = close > upper and r > obLevel

if (longCond)
    strategy.entry("Long", strategy.long)
if (shortCond)
    strategy.entry("Short", strategy.short)
