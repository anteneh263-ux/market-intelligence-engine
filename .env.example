# Market Intelligence Engine — environment configuration.
# Copy to `.env` (`cp .env.example .env`). All values are OPTIONAL — the engine
# runs with sensible defaults and the bundled sample data with no .env at all.

# --- Knowledge Base ---------------------------------------------------------
# Where the corpus lives. Leave unset: the engine auto-locates the bundled
# `knowledge_base/` next to the code, so it works from ANY folder on your Mac.
# Set only if you want to point at a knowledge base elsewhere.
# MIE_KB_ROOT=/absolute/path/to/knowledge_base

# --- Strategy Evaluation data provider (STEP 5) -----------------------------
# csv (default, uses bundled data_csv/) | binance | fmp | coindesk | synthetic
SR_PROVIDER=csv
SR_CSV_ROOT=data_csv
# API keys for live providers (only needed if you use them):
FMP_API_KEY=
COINDESK_API_KEY=

# --- V1 API / market-data service (optional; only for the FastAPI server) ---
DATABASE_URL=sqlite:///./market_intelligence.db
DATA_SOURCE=binance
BINANCE_BASE_URL=https://api.binance.com
FRONTEND_ORIGIN=http://localhost:5173
